# Scutaris — copy to .env and fill in. Never commit .env.

# --- Elasticsearch (Elastic Cloud) ---
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=

# --- Elasticsearch (local / docker fallback; used when CLOUD_ID is empty) ---
ELASTIC_URL=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_REQUEST_TIMEOUT=60

# --- Embeddings ---
# Jina v3 = 1024 dims. Leave JINA_API_KEY empty to use the local MiniLM
# fallback, and set EMBED_DIMS=384 before running scripts/setup_elastic.py.
JINA_API_KEY=
JINA_API_URL=https://api.jina.ai/v1/embeddings
JINA_MODEL=jina-embeddings-v3
EMBED_DIMS=1024
EMBED_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=50

# --- CelesTrak ---
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
CELESTRAK_SATELLITE_GROUP=stations
CELESTRAK_DEBRIS_GROUP=cosmos-2251-debris
HTTP_TIMEOUT=30
INGEST_LIMIT=1000

# --- Grok Imagine (Part 4) ---
# Leave XAI_API_KEY empty to serve /static/mocks/*.png (mock: true).
# Set USE_MOCK_IMAGINE=1 to force mock even when a key is present.
XAI_API_KEY=
USE_MOCK_IMAGINE=
XAI_API_URL=https://api.x.ai/v1/images/generations
# override if xAI image model changes
XAI_IMAGE_MODEL=grok-2-image
