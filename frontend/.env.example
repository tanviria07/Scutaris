# Scutaris frontend - copy to .env.local and fill in when the API exists.
# Phase 1 ships with no backend connection: leave this blank and the app
# serves everything from the in-process mock data service.
#
# Phase 2: point this at the FastAPI service (e.g. http://localhost:8000)
# and getDataService() will switch from mockDataService to httpDataService.
#
# Never put an API key or secret in this file. Anything prefixed with
# NEXT_PUBLIC_ is inlined into the browser bundle and is world-readable.

NEXT_PUBLIC_API_BASE_URL=
