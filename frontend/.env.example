# Scutaris frontend - copy to .env.local and fill in when the API exists.
# Leave this blank and search() stays on the in-process mock data service.
#
# Point this at the FastAPI service (for example http://127.0.0.1:8000)
# so getDataService() uses httpDataService.search(). Catalogue lists stay
# seeded until bulk-read endpoints exist.
#
# Never put an API key or secret in this file. Anything prefixed with
# NEXT_PUBLIC_ is inlined into the browser bundle and is world-readable.

NEXT_PUBLIC_API_BASE_URL=
